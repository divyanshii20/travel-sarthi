{
  "name": "travel-sarthi-backend",
  "version": "1.0.0",
  "description": "Travel Sarthi API server — Node.js + Express + PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.3",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "drizzle-zod": "^0.5.1",
    "express": "^5.0.0",
    "express-rate-limit": "^7.3.1",
    "firebase-admin": "^12.1.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.3.2",
    "jose": "^5.3.0",
    "lucia": "^3.2.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "otpauth": "^9.3.2",
    "pg": "^8.11.5",
    "pino": "^9.1.0",
    "pino-http": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.3",
    "resend": "^3.2.0",
    "sharp": "^0.33.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.5",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.21.4",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
