# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# ─── Database (Supabase / PostgreSQL 16) ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/travel_sarthi

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── JWT / Session ────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=your-session-secret-min-32-chars

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@travelsarthi.com
EMAIL_FROM_NAME=Travel Sarthi

# ─── Firebase (Push Notifications) ───────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Kiwi (Tequila) Flights ───────────────────────────────────────────────────
KIWI_API_KEY=
KIWI_API_BASE=https://api.tequila.kiwi.com

# ─── Amadeus ──────────────────────────────────────────────────────────────────
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# ─── Xotelo (Hotels) ──────────────────────────────────────────────────────────
XOTELO_API_KEY=

# ─── Google AI (Gemini) ───────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Google Places ────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=

# ─── Foursquare ───────────────────────────────────────────────────────────────
FOURSQUARE_API_KEY=

# ─── Open-Meteo (free, no key required) ──────────────────────────────────────
OPEN_METEO_BASE=https://api.open-meteo.com/v1

# ─── WeatherAPI (fallback) ───────────────────────────────────────────────────
WEATHERAPI_KEY=

# ─── AeroDataBox (Flight Disruption) ─────────────────────────────────────────
AERODATABOX_API_KEY=
AERODATABOX_WEBHOOK_SECRET=

# ─── Aviation Stack (Real-time Flights) ───────────────────────────────────────
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1

# ─── ML Service ───────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=

# ─── Storage (Supabase Storage) ───────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_RECEIPTS=receipts

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
